@page
@model Literasi.Pages.Teacher.Dashboard.IndexModel

@{
    ViewData["Title"] = "Dashboard Guru";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Selamat Datang, @Model.TeacherName</h2>
            <p class="text-muted mb-0">Pantau kelas, materi, tugas, dan pengumpulan siswa Anda</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <form method="post" asp-page="/Auth/Logout" class="d-inline">
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                </button>
            </form>
            <span class="badge rounded-pill bg-primary-subtle text-primary fs-6 px-3 py-2 shadow-sm">
                Tahun Ajaran Aktif : @Model.ActiveAcademicYear
            </span>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <small class="text-muted">Kelas Diampu</small>
                            <h2 class="fw-bold mt-2">@Model.TotalClasses</h2>
                        </div>
                        <div class="bg-primary bg-opacity-10 rounded-circle p-3 align-self-start">
                            <i class="bi bi-building text-primary fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <small class="text-muted">Teaching Assignment</small>
                            <h2 class="fw-bold mt-2">@Model.TotalTeachingAssignments</h2>
                        </div>
                        <div class="bg-success bg-opacity-10 rounded-circle p-3 align-self-start">
                            <i class="bi bi-person-video3 text-success fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <small class="text-muted">Bahan Ajar</small>
                            <h2 class="fw-bold mt-2">@Model.TotalLearningMaterials</h2>
                        </div>
                        <div class="bg-warning bg-opacity-10 rounded-circle p-3 align-self-start">
                            <i class="bi bi-file-earmark-text-fill text-warning fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div>
                            <small class="text-muted">Total Tugas</small>
                            <h2 class="fw-bold mt-2">@Model.TotalAssignments</h2>
                        </div>
                        <div class="bg-info bg-opacity-10 rounded-circle p-3 align-self-start">
                            <i class="bi bi-journal-check text-info fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-xl-4 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 bg-light h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-4 p-3 me-3">
                            <i class="bi bi-send-check-fill fs-3"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block">Total Pengumpulan</small>
                            <h3 class="fw-bold mb-0">@Model.TotalSubmissions</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 bg-light h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="bg-danger bg-opacity-10 text-danger rounded-4 p-3 me-3">
                            <i class="bi bi-pencil-square fs-3"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block">Perlu Dinilai</small>
                            <h3 class="fw-bold mb-0">@Model.PendingGrades</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-md-12">
            <div class="card border-0 shadow-sm rounded-4 bg-light h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="bg-success bg-opacity-10 text-success rounded-4 p-3 me-3">
                            <i class="bi bi-check2-circle fs-3"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block">Sudah Dinilai</small>
                            <h3 class="fw-bold mb-0">@Model.ReviewedSubmissions</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-xl-8">

            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0">Tugas Perlu Dinilai</h5>
                        <a asp-page="/Teacher/Assignment/Index" class="btn btn-outline-primary btn-sm">
                            Lihat Semua
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table align-middle table-hover">
                            <thead>
                                <tr>
                                    <th>Tugas</th>
                                    <th>Mapel</th>
                                    <th>Kelas</th>
                                    <th class="text-center">Belum Dinilai</th>
                                    <th class="text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.PendingAssignmentGrades.Any())
                                {
                                    @foreach (var item in Model.PendingAssignmentGrades)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@item.Title</td>
                                            <td>@item.SubjectName</td>
                                            <td>@item.ClassName</td>
                                            <td class="text-center">
                                                <span class="badge bg-danger-subtle text-danger">
                                                    @item.PendingCount submission
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <a asp-page="/Teacher/Assignment/Submissions" asp-route-id="@item.AssignmentId"
                                                   class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-eye"></i> Nilai
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">
                                            Tidak ada tugas yang menunggu penilaian.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0">Kelas & Mata Pelajaran Saya</h5>
                        <span class="text-muted small">@Model.TotalTeachingAssignments penugasan aktif</span>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Mata Pelajaran</th>
                                    <th>Kelas</th>
                                    <th class="text-center">Materi</th>
                                    <th class="text-center">Tugas</th>
                                    <th class="text-center">Siswa</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.TeachingAssignments.Any())
                                {
                                    @foreach (var item in Model.TeachingAssignments)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@item.SubjectName</td>
                                            <td>@item.ClassName</td>
                                            <td class="text-center">@item.MaterialCount</td>
                                            <td class="text-center">@item.AssignmentCount</td>
                                            <td class="text-center">@item.StudentCount</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">
                                            Belum ada teaching assignment untuk akun guru ini.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>

        <div class="col-xl-4">

            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <h5 class="fw-bold mb-0">Aksi Cepat Guru</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-page="/Teacher/Materials/Create" class="btn btn-outline-primary text-start py-2">
                            <i class="bi bi-file-earmark-plus-fill me-2 text-primary"></i> Upload Bahan Ajar
                        </a>
                        <a asp-page="/Teacher/Materials/Index" class="btn btn-outline-success text-start py-2">
                            <i class="bi bi-folder2-open me-2 text-success"></i> Kelola Bahan Ajar
                        </a>
                        <a asp-page="/Teacher/Assignment/Create" class="btn btn-outline-warning text-start py-2">
                            <i class="bi bi-journal-plus me-2 text-warning"></i> Buat Tugas Baru
                        </a>
                        <a asp-page="/Teacher/Assignment/Index" class="btn btn-outline-info text-start py-2">
                            <i class="bi bi-card-checklist me-2 text-info"></i> Kelola & Nilai Tugas
                        </a>
                    </div>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <h5 class="fw-bold mb-0">Bahan Ajar Terbaru</h5>
                </div>
                <div class="card-body">
                    @if (Model.RecentMaterials.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var item in Model.RecentMaterials)
                            {
                                <div class="list-group-item px-0 py-3 border-bottom-0">
                                    <div class="d-flex justify-content-between align-items-start gap-2">
                                        <div>
                                            <h6 class="fw-bold mb-1">@item.Title</h6>
                                            <p class="text-muted small mb-1">@item.SubjectName - @item.ClassName</p>
                                            <small class="text-muted">
                                                <i class="bi bi-clock me-1"></i> @item.UploadedAt.ToString("dd MMM yyyy, HH:mm")
                                            </small>
                                        </div>
                                        <span class="badge @(item.MaterialType == "PDF" ? "bg-danger-subtle text-danger" : item.MaterialType == "PPT" ? "bg-warning-subtle text-warning" : "bg-info-subtle text-info")">
                                            @item.MaterialType
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 my-2 text-muted">
                            <i class="bi bi-folder2-open d-block fs-3 mb-2 text-secondary"></i>
                            Belum ada bahan ajar.
                        </div>
                    }
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 pt-4 px-4">
                    <h5 class="fw-bold mb-0">Pengumpulan Terbaru</h5>
                </div>
                <div class="card-body">
                    @if (Model.RecentSubmissions.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var item in Model.RecentSubmissions)
                            {
                                <div class="list-group-item px-0 py-3 border-bottom-0">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <h6 class="fw-bold mb-0">@item.StudentName</h6>
                                        <span class="badge @(item.Status == "Reviewed" ? "bg-success-subtle text-success" : item.Status == "Late" ? "bg-warning-subtle text-warning" : "bg-primary-subtle text-primary")">
                                            @(item.Status == "Reviewed" ? "Dinilai" : item.Status == "Late" ? "Terlambat" : "Dikumpulkan")
                                        </span>
                                    </div>
                                    <p class="text-muted small mb-1">
                                        @item.AssignmentTitle (@item.ClassName)
                                    </p>
                                    <small class="text-muted">
                                        <i class="bi bi-clock me-1"></i> @item.SubmittedAt.ToString("dd MMM yyyy, HH:mm")
                                    </small>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 my-2 text-muted">
                            <i class="bi bi-send-x d-block fs-3 mb-2 text-secondary"></i>
                            Belum ada tugas dikumpulkan.
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>

</div>
