@page
@model Literasi.Pages.Teacher.Assignments.CreateModel

@{
    ViewData["Title"] = "Tambah Assignment";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Tambah Assignment</h2>
        <p class="text-muted mb-0">Buat tugas baru untuk kelas yang Anda ampu</p>
    </div>
    <a asp-page="/Teacher/Assignment/Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Kembali
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4">

    <div class="card-header bg-white">
        <h4 class="mb-0">
            Tambah Assignment
        </h4>
    </div>

    <div class="card-body">

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">

                <label class="form-label">
                    Teaching Assignment
                </label>

                <select asp-for="Assignment.TeachingAssignmentId" asp-items="Model.TeachingAssignments"
                        class="form-select">

                    <option value="">
                        -- Pilih --
                    </option>

                </select>
                <span asp-validation-for="Assignment.TeachingAssignmentId" class="text-danger small"></span>

            </div>

            <div class="mb-3">

                <label asp-for="Assignment.Title" class="form-label">
                </label>

                <input asp-for="Assignment.Title" class="form-control" />
                <span asp-validation-for="Assignment.Title" class="text-danger small"></span>

            </div>

            <div class="mb-3">

                <label asp-for="Assignment.Description" class="form-label">
                    Tambahkan keterangan Tugas disini
                </label>

                <textarea asp-for="Assignment.Description" rows="5" class="form-control">
                </textarea>

            </div>

            <div class="mb-3">

                <label asp-for="Assignment.Deadline" class="form-label">
                </label>

                <input asp-for="Assignment.Deadline" type="datetime-local" class="form-control" />
                <span asp-validation-for="Assignment.Deadline" class="text-danger small"></span>

            </div>

            <button type="submit" class="btn btn-primary">

                Simpan

            </button>
            <a asp-page="/Teacher/Assignment/Index" class="btn btn-outline-secondary">
                Batal
            </a>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
