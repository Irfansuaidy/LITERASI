@page
@model Literasi.Pages.Teacher.Assignments.IndexModel

@{
    ViewData["Title"] = "Assignments";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-1">
            Assignments
        </h2>

        <p class="text-muted mb-0">
            Kelola tugas siswa
        </p>
    </div>
    <a asp-page="/Teacher/Dashboard/Index" class="btn btn-outline-secondary">
        Kembali
    </a>
    <a asp-page="./Create" class="btn btn-primary">
        Tambah Assignment
    </a>

</div>

<div class="card border-0 shadow-sm rounded-4">

    <div class="card-body">

        <table class="table align-middle">

            <thead>
                <tr>
                    <th>Judul</th>
                    <th>Mapel</th>
                    <th>Kelas</th>
                    <th>Deadline</th>
                    <th>Pengumpulan</th>
                    <th width="260">Aksi</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model.Assignments)
                {
                    <tr>

                        <td>@item.Title</td>

                        <td>@item.TeachingAssignment.Subject.SubjectName</td>

                        <td>@item.TeachingAssignment.Class.ClassName</td>

                        <td>@item.Deadline.ToString("dd MMM yyyy, HH:mm")</td>

                        <td>
                            <span class="badge bg-primary-subtle text-primary">
                                @item.Submissions.Count submission
                            </span>
                        </td>

                        <td>
                            <a asp-page="./Submissions" asp-route-id="@item.AssignmentId"
                               class="btn btn-info btn-sm text-white">
                                View Submissions
                            </a>

                            <a asp-page="./Edit" asp-route-id="@item.AssignmentId" class="btn btn-warning btn-sm">
                                Edit
                            </a>

                            <a asp-page="./Delete" asp-route-id="@item.AssignmentId" class="btn btn-danger btn-sm">
                                Hapus
                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>
