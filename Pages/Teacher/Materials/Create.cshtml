@page
@model Literasi.Pages.Teacher.LearningMaterials.CreateModel

@{
    ViewData["Title"] = "Tambah Materi";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Tambah Bahan Ajar</h2>
            <p class="text-muted mb-0">Unggah materi pelajaran untuk siswa Anda</p>
        </div>
        <a asp-page="/Teacher/Dashboard/Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Kembali
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <form method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row">
                    <div class="col-md-6 border-end">
                        <h5 class="fw-bold text-primary mb-3">
                            <i class="bi bi-file-earmark-plus me-1"></i> Informasi Materi
                        </h5>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Teaching Assignment (Mapel - Kelas)</label>
                            <select asp-for="LearningMaterial.TeachingAssignmentId"
                                    asp-items="Model.TeachingAssignments" class="form-select">
                                <option value="">-- Pilih Mapel & Kelas --</option>
                            </select>
                            <span asp-validation-for="LearningMaterial.TeachingAssignmentId"
                                  class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LearningMaterial.Title" class="form-label fw-semibold">Judul Materi</label>
                            <input asp-for="LearningMaterial.Title" class="form-control"
                                   placeholder="Contoh: Bab 1 - Pengenalan Algoritma" />
                            <span asp-validation-for="LearningMaterial.Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LearningMaterial.Description" class="form-label fw-semibold">Deskripsi /
                                Keterangan</label>
                                <textarea asp-for="LearningMaterial.Description" rows="4" class="form-control"
                                          placeholder="Deskripsi singkat materi..."></textarea>
                            </div>
                        </div>

                        <div class="col-md-6 ps-md-4">
                            <h5 class="fw-bold text-primary mb-3">
                                <i class="bi bi-cloud-arrow-up me-1"></i> Sumber Berkas
                            </h5>

                            <div class="mb-3">
                                <label asp-for="LearningMaterial.MaterialType" class="form-label fw-semibold">Tipe
                                    Materi</label>
                                    <select asp-for="LearningMaterial.MaterialType" class="form-select" id="materialTypeSelect"
                                            onchange="toggleUploadFields()">
                                        <option value="PDF">PDF (Dokumen / Buku Paket)</option>
                                        <option value="PPT">PPT (Presentasi PowerPoint)</option>
                                        <option value="LINK">LINK (Tautan Eksternal)</option>
                                    </select>
                                </div>

                                <!-- File Upload Section -->
                                <div class="mb-3" id="fileUploadSection">
                                    <label class="form-label fw-semibold">Unggah File</label>
                                    <input class="form-control" type="file" name="UploadedFile" id="fileInput"
                                           accept=".pdf,.ppt,.pptx" />
                                    <span asp-validation-for="UploadedFile" class="text-danger small"></span>
                                    <div class="form-text text-muted small mt-1" id="fileSizeHint">
                                        Maksimal: <strong>50MB</strong> (PDF) atau <strong>25MB</strong> (PPT)
                                    </div>
                                </div>

                                <!-- External URL Section -->
                                <div class="mb-3" id="externalUrlSection" style="display: none;">
                                    <label asp-for="LearningMaterial.ExternalUrl" class="form-label fw-semibold">Tautan
                                        Eksternal (URL)</label>
                                        <input asp-for="LearningMaterial.ExternalUrl" class="form-control"
                                               placeholder="https://contoh.com/materi" />
                                        <span asp-validation-for="LearningMaterial.ExternalUrl" class="text-danger small"></span>
                                    </div>

                                    <div class="alert alert-info rounded-3 small mt-3" role="alert">
                                        <i class="bi bi-info-circle-fill me-1"></i>
                                        <strong>Tips:</strong> Untuk materi berukuran besar, pastikan file telah dikompresi terlebih
                                        dahulu agar proses unggah lebih cepat.
                                    </div>
                                </div>
                            </div>

                            <hr class="my-4" />

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary px-4">
                                    <i class="bi bi-save me-1"></i> Simpan Materi
                                </button>
                                <a asp-page="/Teacher/Materials/Index" class="btn btn-outline-secondary px-4">
                                    Batal
                                </a>
                            </div>
                        </form>

                    </div>
                </div>

            </div>

            @section Scripts {
                @{
                    await Html.RenderPartialAsync("_ValidationScriptsPartial");
                }
                <script>
                    function toggleUploadFields() {
                        const type = document.getElementById('materialTypeSelect').value;
                        const fileSection = document.getElementById('fileUploadSection');
                        const urlSection = document.getElementById('externalUrlSection');

                        if (type === 'LINK') {
                            fileSection.style.display = 'none';
                            urlSection.style.display = 'block';
                            document.getElementById('fileInput').value = '';
                        } else {
                            fileSection.style.display = 'block';
                            urlSection.style.display = 'none';
                        }
                    }
                    toggleUploadFields();
                </script>
            }
