@page
@model Literasi.Pages.Teacher.LearningMaterials.CreateModel

@{
    ViewData["Title"] = "Tambah Materi";
}

<div class="card border-0 shadow-sm rounded-4">

    <div class="card-header bg-white">
        <h4 class="mb-0">Tambah Materi</h4>
    </div>

    <div class="card-body">

        <form method="post">

            <div class="mb-3">
                <label class="form-label">
                    Teaching Assignment
                </label>

                <select asp-for="LearningMaterial.TeachingAssignmentId" asp-items="Model.TeachingAssignments"
                        class="form-select">
                    <option value="">
                        -- Pilih --
                    </option>
                </select>
            </div>

            <div class="mb-3">
                <label asp-for="LearningMaterial.Title" class="form-label">
                </label>

                <input asp-for="LearningMaterial.Title" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="LearningMaterial.Description" class="form-label">
                </label>

                <textarea asp-for="LearningMaterial.Description" rows="4" class="form-control">
                </textarea>
            </div>

            <div class="mb-3">
                <label asp-for="LearningMaterial.ExternalUrl" class="form-label">
                </label>

                <input asp-for="LearningMaterial.ExternalUrl" class="form-control" />
            </div>

            <button type="submit" class="btn btn-primary">
                Simpan
            </button>

        </form>

    </div>

</div>