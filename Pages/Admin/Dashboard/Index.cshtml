@page
@model Literasi.Pages.Admin.Dashboard.IndexModel

@{
    ViewData["Title"] = "Dashboard Admin";
}

<div class="container-fluid">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Selamat Datang, Admin 👋
            </h2>

            <p class="text-muted mb-0">
                Kelola seluruh aktivitas Literasi LMS
            </p>
        </div>

        <div>
            <span class="badge rounded-pill bg-primary-subtle text-primary fs-6 px-3 py-2">
                Tahun Ajaran Aktif :
                @Model.ActiveAcademicYear
            </span>
        </div>

    </div>

    <!-- KPI Cards -->
    <div class="row g-4 mb-4">

        <!-- Students -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>
                            <small class="text-muted">
                                Jumlah Siswa
                            </small>

                            <h2 class="fw-bold mt-2">
                                @Model.TotalStudents
                            </h2>
                        </div>

                        <div class="bg-primary bg-opacity-10 rounded-circle p-3 align-self-start">
                            <i class="bi bi-people-fill text-primary fs-4"></i>
                        </div>

                    </div>

                </div>
            </div>
        </div>

        <!-- Teachers -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>
                            <small class="text-muted">
                                Jumlah Guru
                            </small>

                            <h2 class="fw-bold mt-2">
                                @Model.TotalTeachers
                            </h2>
                        </div>

                        <div class="bg-success bg-opacity-10 rounded-circle p-3 align-self-start">
                            <i class="bi bi-person-workspace text-success fs-4"></i>
                        </div>

                    </div>

                </div>
            </div>
        </div>

        <!-- Classes -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>
                            <small class="text-muted">
                                Jumlah Kelas
                            </small>

                            <h2 class="fw-bold mt-2">
                                @Model.TotalClasses
                            </h2>
                        </div>

                        <div class="bg-warning bg-opacity-10 rounded-circle p-3 align-self-start">
                            <i class="bi bi-building text-warning fs-4"></i>
                        </div>

                    </div>

                </div>
            </div>
        </div>

        <!-- Subjects -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>
                            <small class="text-muted">
                                Mata Pelajaran
                            </small>

                            <h2 class="fw-bold mt-2">
                                @Model.TotalSubjects
                            </h2>
                        </div>

                        <div class="bg-info bg-opacity-10 rounded-circle p-3 align-self-start">
                            <i class="bi bi-book-fill text-info fs-4"></i>
                        </div>

                    </div>

                </div>
            </div>
        </div>

    </div>

    <!-- Teaching Assignment -->
    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-header bg-white border-0 pt-4 px-4">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="fw-bold mb-0">
                    Teaching Assignment
                </h5>

                <a asp-page="/Admin/TeachingAssignment/Index" class="btn btn-outline-primary btn-sm">
                    Lihat Semua
                </a>

            </div>

        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>

                        <tr>
                            <th>Guru Pengampu</th>
                            <th>Mata Pelajaran</th>
                            <th>Kelas</th>
                            <th>Status</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.TeachingAssignments.Any())
                        {
                            @foreach (var item in Model.TeachingAssignments)
                            {
                                <tr>

                                    <td>
                                        @item.TeacherName
                                    </td>

                                    <td>
                                        @item.SubjectName
                                    </td>

                                    <td>
                                        @item.ClassName
                                    </td>

                                    <td>

                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success">
                                                Aktif
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger">
                                                Nonaktif
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="4" class="text-center text-muted py-4">
                                    Belum ada data Teaching Assignment
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>