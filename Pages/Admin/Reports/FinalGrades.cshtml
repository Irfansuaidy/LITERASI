@page
@model Literasi.Pages.Admin.Reports.FinalGradesModel

@{
    ViewData["Title"] = "Laporan Nilai Akhir";
}

<!-- Style khusus print untuk menyembunyikan header/footer default dan mengatur layout -->
<style>
    @@media print {
        body {
            background-color: #fff;
            color: #000;
            font-size: 12px;
        }
        .container-fluid {
            padding: 0;
        }
        .card {
            border: 0 !important;
            box-shadow: none !important;
        }
        .table {
            border-collapse: collapse !important;
            width: 100% !important;
        }
        .table th, .table td {
            border: 1px solid #dee2e6 !important;
            padding: 0.5rem !important;
        }
        .badge {
            border: 1px solid #000;
            background-color: transparent !important;
            color: #000 !important;
            padding: 0 !important;
        }
    }
</style>

<div class="container-fluid">

    <!-- Header Halaman (Disembunyikan saat cetak) -->
    <div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
        <div>
            <h2 class="fw-bold mb-1">Laporan Nilai Akhir</h2>
            <p class="text-muted mb-0">Rekapitulasi nilai akhir siswa per mata pelajaran</p>
        </div>
        <div class="d-flex gap-2">
            @if (Model.ClassId.HasValue && Model.GradeMatrix.Any())
            {
                <button onclick="window.print();" class="btn btn-primary">
                    <i class="bi bi-printer-fill me-1"></i> Cetak Laporan
                </button>
            }
            <a asp-page="/Admin/Dashboard/Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Kembali
            </a>
        </div>
    </div>

    <!-- Filter Kelas (Disembunyikan saat cetak) -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 d-print-none">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3">Pilih Kelas & Tahun Ajaran</h5>
            <form method="get" id="classSelectForm">
                <div class="row align-items-end g-3">
                    <div class="col-md-9">
                        <select name="ClassId" asp-for="ClassId" asp-items="Model.ClassOptions" class="form-select" onchange="document.getElementById('classSelectForm').submit();">
                            <option value="">-- Pilih Kelas --</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-funnel-fill me-1"></i> Filter
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (Model.ClassId.HasValue)
    {
        <!-- Tampilan Kertas Laporan (Muncul saat print & layar biasa) -->
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                
                <!-- Kop Surat Laporan (Sederhana) -->
                <div class="text-center mb-4">
                    <h3 class="fw-bold mb-1">REKAPITULASI NILAI AKHIR SISWA</h3>
                    <h5 class="text-muted mb-0">LMS LITERASI</h5>
                    <div class="mt-3 d-flex justify-content-center gap-4 small fw-semibold text-secondary">
                        <span>KELAS: @Model.SelectedClassName</span>
                        <span>TAHUN AJARAN: @Model.SelectedAcademicYear</span>
                    </div>
                    <hr class="my-4 border-2" />
                </div>

                @if (Model.GradeMatrix.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle">
                            <thead class="table-light text-center">
                                <tr>
                                    <th width="50px" rowspan="2">No</th>
                                    <th rowspan="2">Nama Lengkap</th>
                                    <th width="120px" rowspan="2">NISN</th>
                                    @if (Model.SubjectColumns.Any())
                                    {
                                        <th colspan="@Model.SubjectColumns.Count">Mata Pelajaran</th>
                                    }
                                    <th width="120px" rowspan="2">Rata-rata</th>
                                </tr>
                                <tr>
                                    @foreach (var subject in Model.SubjectColumns)
                                    {
                                        <th class="small py-2" style="min-width: 120px;" title="@subject.SubjectName">
                                            <span class="d-block text-truncate">@subject.SubjectName</span>
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int no = 1;
                                }
                                @foreach (var row in Model.GradeMatrix)
                                {
                                    <tr>
                                        <td class="text-center font-monospace">@no++</td>
                                        <td class="fw-semibold">@row.StudentName</td>
                                        <td class="text-center font-monospace">@row.Nisn</td>
                                        
                                        @foreach (var subject in Model.SubjectColumns)
                                        {
                                            var score = row.SubjectScores[subject.SubjectId];
                                            <td class="text-center font-monospace">
                                                @(score.HasValue ? score.Value.ToString("0.##") : "-")
                                            </td>
                                        }

                                        <td class="text-center font-monospace fw-bold">
                                            @if (row.AverageScore >= 75)
                                            {
                                                <span class="badge bg-success-subtle text-success px-2 py-1 rounded">
                                                    @row.AverageScore
                                                </span>
                                            }
                                            else if (row.AverageScore > 0)
                                            {
                                                <span class="badge bg-danger-subtle text-danger px-2 py-1 rounded">
                                                    @row.AverageScore
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Tanda Tangan Cetak (Hanya muncul saat dicetak) -->
                    <div class="row mt-5 d-none d-print-flex justify-content-end">
                        <div class="col-4 text-center">
                            <p class="mb-5">Mengetahui,<br>Administrator LMS</p>
                            <div class="border-bottom w-75 mx-auto mb-1"></div>
                            <small class="text-muted">NIP. __________________</small>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-info rounded-3 text-center my-4">
                        <i class="bi bi-info-circle me-2"></i> Belum ada data siswa atau tugas terdaftar untuk kelas ini.
                    </div>
                }

            </div>
        </div>
    }

</div>
