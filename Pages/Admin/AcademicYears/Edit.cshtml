@page "{id:int}"
@model Literasi.Pages.Admin.AcademicYears.EditModel

@{
    ViewData["Title"] = "Edit Tahun Ajaran";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Edit Tahun Ajaran</h2>
            <p class="text-muted mb-0">Ubah data tahun ajaran</p>
        </div>
        <a asp-page="/Admin/AcademicYears/Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Kembali
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <form method="post">
                <input type="hidden" asp-for="AcademicYear.AcademicYearId" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="AcademicYear.YearName" class="form-label fw-semibold">
                        Nama Tahun Ajaran
                    </label>
                    <input asp-for="AcademicYear.YearName" class="form-control"
                           placeholder="Contoh: 2024/2025" />
                    <span asp-validation-for="AcademicYear.YearName" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="AcademicYear.StartDate" class="form-label fw-semibold">
                            Tanggal Mulai
                        </label>
                        <input asp-for="AcademicYear.StartDate" type="date" class="form-control" />
                        <span asp-validation-for="AcademicYear.StartDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="AcademicYear.EndDate" class="form-label fw-semibold">
                            Tanggal Selesai
                        </label>
                        <input asp-for="AcademicYear.EndDate" type="date" class="form-control" />
                        <span asp-validation-for="AcademicYear.EndDate" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <div class="form-check form-switch">
                        <input asp-for="AcademicYear.IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="AcademicYear.IsActive" class="form-check-label fw-semibold">
                            Aktifkan Tahun Ajaran Ini
                        </label>
                    </div>
                    <small class="text-muted">
                        Mengaktifkan tahun ajaran ini akan menonaktifkan tahun ajaran yang sedang aktif.
                    </small>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save me-1"></i> Simpan Perubahan
                    </button>
                    <a asp-page="/Admin/AcademicYears/Index" class="btn btn-outline-secondary px-4">
                        Batal
                    </a>
                </div>
            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
