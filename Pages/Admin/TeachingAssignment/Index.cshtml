@page
@model Literasi.Pages.Admin.TeachingAssignment.IndexModel

@{
    ViewData["Title"] = "Penugasan Mengajar";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Penugasan Mengajar</h2>
            <p class="text-muted mb-0">Kelola penugasan guru per mata pelajaran dan kelas</p>
        </div>
        <a asp-page="/Admin/Dashboard/Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Kembali
        </a>
        <a asp-page="/Admin/TeachingAssignment/Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Tambah Penugasan
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
            <i class="bi bi-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
            <i class="bi bi-x-circle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Guru Pengampu</th>
                            <th>Mata Pelajaran</th>
                            <th>Kelas</th>
                            <th>Tahun Ajaran</th>
                            <th>Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Assignments.Any())
                        {
                            int no = 1;
                            @foreach (var item in Model.Assignments)
                            {
                                <tr>
                                    <td>@no++</td>
                                    <td class="fw-semibold">@item.TeacherName</td>
                                    <td>@item.SubjectName</td>
                                    <td>@item.ClassName</td>
                                    <td>
                                        <span class="badge bg-secondary-subtle text-secondary">
                                            @item.AcademicYear
                                        </span>
                                    </td>
                                    <td>
                                        <form method="post" asp-page-handler="Delete"
                                              onsubmit="return confirm('Hapus penugasan ini?')">
                                            <input type="hidden" name="id" value="@item.TeachingAssignmentId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i> Hapus
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    Belum ada data penugasan mengajar
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
