@page
@model Literasi.Pages.Admin.TeachingAssignment.CreateModel

@{
    ViewData["Title"] = "Tambah Penugasan Mengajar";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Tambah Penugasan Mengajar</h2>
            <p class="text-muted mb-0">Tetapkan guru untuk mengajar mata pelajaran di kelas tertentu</p>
        </div>
        <a asp-page="/Admin/TeachingAssignment/Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Kembali
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Assignment.TeacherId" class="form-label fw-semibold">
                        Guru Pengampu
                    </label>
                    <select asp-for="Assignment.TeacherId"
                            asp-items="Model.TeacherOptions"
                            class="form-select">
                        <option value="">-- Pilih Guru --</option>
                    </select>
                    <span asp-validation-for="Assignment.TeacherId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Assignment.SubjectId" class="form-label fw-semibold">
                        Mata Pelajaran
                    </label>
                    <select asp-for="Assignment.SubjectId"
                            asp-items="Model.SubjectOptions"
                            class="form-select">
                        <option value="">-- Pilih Mata Pelajaran --</option>
                    </select>
                    <span asp-validation-for="Assignment.SubjectId" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Assignment.ClassId" class="form-label fw-semibold">
                        Kelas
                    </label>
                    <select asp-for="Assignment.ClassId"
                            asp-items="Model.ClassOptions"
                            class="form-select">
                        <option value="">-- Pilih Kelas --</option>
                    </select>
                    <span asp-validation-for="Assignment.ClassId" class="text-danger small"></span>
                </div>

                <div class="alert alert-info rounded-3 small">
                    <i class="bi bi-info-circle me-1"></i>
                    Kombinasi Guru + Mata Pelajaran + Kelas harus unik.
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save me-1"></i> Simpan
                    </button>
                    <a asp-page="/Admin/TeachingAssignment/Index" class="btn btn-outline-secondary px-4">
                        Batal
                    </a>
                </div>
            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
