@page
@model Literasi.Pages.Admin.Teachers.IndexModel

@{
    ViewData["Title"] = "Data Guru";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Data Guru</h2>
            <p class="text-muted mb-0">Kelola data seluruh guru</p>
        </div>
        <a asp-page="/Admin/Dashboard/Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Kembali
        </a>
        <a asp-page="/Admin/Teachers/Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Tambah Guru
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
            <i class="bi bi-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Nama Lengkap</th>
                            <th>NIP</th>
                            <th>Username</th>
                            <th>Email</th>
                            <th>Jenis Kelamin</th>
                            <th>Status</th>
                            <th class="text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Teachers.Any())
                        {
                            int no = 1;
                            @foreach (var item in Model.Teachers)
                            {
                                <tr>
                                    <td>@no++</td>
                                    <td class="fw-semibold">@item.FullName</td>
                                    <td><code>@item.Nip</code></td>
                                    <td>@item.Username</td>
                                    <td>@item.Email</td>
                                    <td>
                                        @(item.Gender == "L" ? "Laki-laki" : "Perempuan")
                                    </td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success">Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger">Nonaktif</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-page="./Edit" asp-route-id="@item.TeacherId"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil-square me-1"></i> Edit
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">
                                    Belum ada data guru
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
