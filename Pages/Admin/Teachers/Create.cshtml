@page
@model Literasi.Pages.Admin.Teachers.CreateModel

@{
    ViewData["Title"] = "Tambah Guru";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Tambah Guru</h2>
            <p class="text-muted mb-0">Daftarkan guru baru</p>
        </div>
        <a asp-page="/Admin/Teachers/Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Kembali
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <h6 class="fw-bold text-muted text-uppercase small mb-3">Informasi Akun</h6>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.FullName" class="form-label fw-semibold">
                            Nama Lengkap
                        </label>
                        <input asp-for="Input.FullName" class="form-control"
                               placeholder="Nama lengkap guru" />
                        <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.Username" class="form-label fw-semibold">
                            Username
                        </label>
                        <input asp-for="Input.Username" class="form-control"
                               placeholder="Username untuk login" />
                        <span asp-validation-for="Input.Username" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.Email" class="form-label fw-semibold">
                            Email
                        </label>
                        <input asp-for="Input.Email" type="email" class="form-control"
                               placeholder="email@sekolah.sch.id" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Input.Password" class="form-label fw-semibold">
                            Password
                        </label>
                        <input asp-for="Input.Password" type="password" class="form-control"
                               placeholder="Minimal 6 karakter" />
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Gender" class="form-label fw-semibold">
                        Jenis Kelamin
                    </label>
                    <select asp-for="Input.Gender" class="form-select">
                        <option value="">-- Pilih Jenis Kelamin --</option>
                        <option value="L">Laki-laki</option>
                        <option value="P">Perempuan</option>
                    </select>
                    <span asp-validation-for="Input.Gender" class="text-danger small"></span>
                </div>

                <hr class="my-4" />
                <h6 class="fw-bold text-muted text-uppercase small mb-3">Informasi Guru</h6>

                <div class="mb-3">
                    <label asp-for="Input.Nip" class="form-label fw-semibold">
                        NIP
                    </label>
                    <input asp-for="Input.Nip" class="form-control"
                           placeholder="Nomor Induk Pegawai" />
                    <span asp-validation-for="Input.Nip" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2 mt-2">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-save me-1"></i> Simpan
                    </button>
                    <a asp-page="/Admin/Teachers/Index" class="btn btn-outline-secondary px-4">
                        Batal
                    </a>
                </div>
            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
