@page
@model Literasi.Pages.Admin.Import.IndexModel

@{
    ViewData["Title"] = "Import Data CSV";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Import Data CSV</h2>
            <p class="text-muted mb-0">Tambahkan data guru atau siswa secara massal menggunakan file CSV (Excel)</p>
        </div>
        <a asp-page="/Admin/Dashboard/Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Kembali ke Dashboard
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-info-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Kolom Kiri: Form Upload & Hasil Log -->
        <div class="col-xl-8">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3 text-primary">Form Upload CSV</h5>

                    <form method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Tipe Import</label>
                            <div class="d-flex gap-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="ImportType" id="importSiswa" value="Siswa" asp-for="ImportType" checked onchange="toggleFormatInfo()">
                                    <label class="form-check-label fw-semibold" for="importSiswa">Data Siswa</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="ImportType" id="importGuru" value="Guru" asp-for="ImportType" onchange="toggleFormatInfo()">
                                    <label class="form-check-label fw-semibold" for="importGuru">Data Guru</label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="csvFile" class="form-label fw-semibold">Pilih File CSV</label>
                            <input class="form-control" type="file" id="csvFile" name="UploadedFile" accept=".csv" required>
                            <div class="form-text text-muted small mt-1">
                                Pastikan file berformat <strong>.csv</strong> dan menggunakan koma (,) sebagai pembatas antar kolom.
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary px-4 py-2">
                            <i class="bi bi-cloud-arrow-up-fill me-1"></i> Mulai Proses Import
                        </button>
                    </form>
                </div>
            </div>

            <!-- Log Hasil Import -->
            @if (Model.SuccessLogs.Any() || Model.ErrorLogs.Any())
            {
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3">Laporan Log Hasil Import</h5>

                        <ul class="nav nav-tabs" id="logTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active text-success fw-semibold" id="success-tab" data-bs-toggle="tab" data-bs-target="#successLog" type="button" role="tab">
                                    Sukses (@Model.SuccessLogs.Count)
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link text-danger fw-semibold" id="error-tab" data-bs-toggle="tab" data-bs-target="#errorLog" type="button" role="tab">
                                    Gagal (@Model.ErrorLogs.Count)
                                </button>
                            </li>
                        </ul>
                        <div class="tab-content border border-top-0 p-3 bg-light rounded-bottom-3" id="logTabsContent" style="max-height: 300px; overflow-y: auto;">
                            <!-- Tab Sukses -->
                            <div class="tab-pane fade show active" id="successLog" role="tabpanel">
                                @if (Model.SuccessLogs.Any())
                                {
                                    <ul class="list-unstyled mb-0">
                                        @foreach (var log in Model.SuccessLogs)
                                        {
                                            <li class="text-success small mb-1"><i class="bi bi-check-circle-fill me-1"></i> @log</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <span class="text-muted small">Tidak ada data yang berhasil diimport.</span>
                                }
                            </div>
                            <!-- Tab Gagal -->
                            <div class="tab-pane fade" id="errorLog" role="tabpanel">
                                @if (Model.ErrorLogs.Any())
                                {
                                    <ul class="list-unstyled mb-0">
                                        @foreach (var log in Model.ErrorLogs)
                                        {
                                            <li class="text-danger small mb-1"><i class="bi bi-x-circle-fill me-1"></i> @log</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <span class="text-muted small">Tidak ada baris yang gagal diimport.</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Kolom Kanan: Aturan Format & Daftar ID Kelas -->
        <div class="col-xl-4">
            <!-- Aturan Format -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3"><i class="bi bi-info-circle-fill text-warning me-1"></i> Aturan Format CSV</h5>
                    
                    <div id="siswaFormatInfo">
                        <p class="small text-muted">Untuk import <strong>Siswa</strong>, susunan kolom header pada baris pertama harus seperti berikut:</p>
                        <code class="d-block bg-dark text-white p-2 rounded mb-3 small">FullName,Username,Email,Password,Gender,Nisn,ClassId</code>
                        <ul class="small text-muted ps-3 mb-0">
                            <li><strong>Gender</strong>: Hanya menerima huruf <strong>L</strong> (Laki-laki) atau <strong>P</strong> (Perempuan).</li>
                            <li><strong>ClassId</strong>: Harus diisi angka ID Kelas yang valid (lihat tabel di bawah).</li>
                            <li>Pastikan tidak ada spasi di sela-sela koma pemisah kolom.</li>
                        </ul>
                    </div>

                    <div id="guruFormatInfo" style="display: none;">
                        <p class="small text-muted">Untuk import <strong>Guru</strong>, susunan kolom header pada baris pertama harus seperti berikut:</p>
                        <code class="d-block bg-dark text-white p-2 rounded mb-3 small">FullName,Username,Email,Password,Gender,Nip</code>
                        <ul class="small text-muted ps-3 mb-0">
                            <li><strong>Gender</strong>: Hanya menerima huruf <strong>L</strong> atau <strong>P</strong>.</li>
                            <li><strong>Nip</strong>: Wajib unik dan belum terdaftar di sistem.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Daftar ID Kelas (Khusus Siswa) -->
            <div class="card border-0 shadow-sm rounded-4" id="classIdReferenceCard">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-2"><i class="bi bi-table text-primary me-1"></i> Referensi ClassId</h5>
                    <p class="small text-muted mb-3">Gunakan ID di bawah untuk mengisi kolom <strong>ClassId</strong> pada file CSV Siswa.</p>

                    <div class="table-responsive" style="max-height: 350px; overflow-y: auto;">
                        <table class="table table-sm table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Nama Kelas</th>
                                    <th>Tahun Ajaran</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cls in Model.AvailableClasses)
                                {
                                    <tr>
                                        <td><span class="badge bg-secondary font-monospace">@cls.ClassId</span></td>
                                        <td class="fw-semibold">@cls.ClassName</td>
                                        <td><small>@cls.AcademicYear</small></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        function toggleFormatInfo() {
            const isSiswa = document.getElementById('importSiswa').checked;
            const classRefCard = document.getElementById('classIdReferenceCard');
            const siswaInfo = document.getElementById('siswaFormatInfo');
            const guruInfo = document.getElementById('guruFormatInfo');

            if (isSiswa) {
                siswaInfo.style.display = 'block';
                guruInfo.style.display = 'none';
                classRefCard.style.display = 'block';
            } else {
                siswaInfo.style.display = 'none';
                guruInfo.style.display = 'block';
                classRefCard.style.display = 'none';
            }
        }
        
        // Initial call
        toggleFormatInfo();
    </script>
}
